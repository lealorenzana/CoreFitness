VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Where the "Member app" button in the header points. Without it the
# button assumes localhost:5173, which is right on a dev machine and wrong on
# the gym's laptop, where the member app is the deployed one. Set it to the
# live URL there.
VITE_MEMBER_URL=https://your-member-app.vercel.app

# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings > API). See ../supabase/README.md for setup.
# .env.local is already gitignored (*.local rule) — never commit real keys.
