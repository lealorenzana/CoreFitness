// The shared texts the assistants search (0282), generated from where they live — never typed twice.
//   Terms.tsx / Privacy.tsx (member app): one row per section, read with the TypeScript parser. A line
//     that a function builds from the member's gym (freezeLine(state), …) becomes a pointer to the
//     gym's own settings, which the assistant reads with get_gym_info.
//   lib/guides.ts: one row per guide step, English shown, Filipino searched.
// Writes supabase/knowledge/texts.sql (pasted when it changes; safe to paste again).
// Run:   node --experimental-strip-types scripts/knowledge-seed.mts
// Check: node --experimental-strip-types scripts/knowledge-seed.mts --check   (fails if the file is stale)
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { createRequire } from 'node:module';
import { GUIDES } from '../g-fitness-member/src/lib/guides.ts';

// The member app's TypeScript when it is installed; else one installed where this runs (CI's SQL job).
const ts = (() => {
  try { return createRequire(import.meta.url)('../g-fitness-member/node_modules/typescript'); }
  catch { return createRequire(process.cwd() + '/')('typescript'); }
})() as typeof import('typescript');

type Row = { id: string; source: string; audience: string; title: string; body: string; extra: string | null; link: string | null };
const rows: Row[] = [];
const GYM_RULE = '(This part is your gym\'s own rule: read it from the gym\'s settings.)';

/** Text of a string literal, a no-substitution template, or a concatenation of them; null for anything built at run time. */
function literal(n: import('typescript').Node): string | null {
  if (ts.isStringLiteral(n) || ts.isNoSubstitutionTemplateLiteral(n)) return n.text;
  if (ts.isBinaryExpression(n) && n.operatorToken.kind === ts.SyntaxKind.PlusToken) {
    const a = literal(n.left), b = literal(n.right);
    return a !== null && b !== null ? a + b : null;
  }
  if (ts.isParenthesizedExpression(n)) return literal(n.expression);
  return null;
}

function legal(file: string, source: 'terms' | 'privacy', route: string) {
  const sf = ts.createSourceFile(file, readFileSync(file, 'utf8'), ts.ScriptTarget.Latest, true, ts.ScriptKind.TSX);
  let found = 0;
  const visit = (n: import('typescript').Node) => {
    if (ts.isObjectLiteralExpression(n)) {
      const prop = (name: string) => n.properties.find((p): p is import('typescript').PropertyAssignment =>
        ts.isPropertyAssignment(p) && ts.isIdentifier(p.name) && p.name.text === name)?.initializer;
      const id = prop('id'), title = prop('title'), body = prop('body');
      if (id && title && body && literal(id) && literal(title)) {
        const items = ts.isArrayLiteralExpression(body) ? [...body.elements] : [body];
        const lines: string[] = [];
        for (const it of items) {
          const s = literal(it);
          if (s !== null) lines.push(s);
          else if (!lines.includes(GYM_RULE)) lines.push(GYM_RULE);
        }
        rows.push({ id: `${source}:${literal(id)}`, source, audience: 'member', title: `${source === 'terms' ? 'Terms' : 'Privacy'} ${literal(title)}`,
          body: lines.join('\n'), extra: null, link: `${route}#${literal(id)}` });
        found++;
        return;
      }
    }
    ts.forEachChild(n, visit);
  };
  visit(sf);
  if (found < 5) throw new Error(`${file}: found only ${found} sections; has its shape changed?`);
}

legal('g-fitness-member/src/pages/Terms.tsx', 'terms', '/terms');
legal('g-fitness-member/src/pages/Privacy.tsx', 'privacy', '/privacy');

for (const g of GUIDES) {
  // Owner guides are read by the owner and the desk (the page itself still decides who may act there).
  const audience = g.for === 'owner' ? 'staff' : 'member';
  rows.push({ id: `guide:${g.id}`, source: 'guide', audience, title: `Guide: ${g.title.en}`, body: g.blurb.en,
    extra: `${g.title.fil}. ${g.blurb.fil}`, link: g.where ?? null });
  g.steps.forEach((s, i) => rows.push({
    id: `guide:${g.id}:${i + 1}`, source: 'guide', audience, title: `Guide: ${g.title.en}, step ${i + 1}: ${s.title.en}`,
    body: s.text.en, extra: `${s.title.fil}. ${s.text.fil}`, link: g.where ?? null,
  }));
}

const ids = new Set<string>();
for (const r of rows) { if (ids.has(r.id)) throw new Error(`duplicate id ${r.id}`); ids.add(r.id); }

const q = (s: string | null) => (s === null ? 'null' : `'${s.replace(/'/g, "''")}'`);
const values = rows.map((r) => `  (${[r.id, r.source, r.audience, r.title, r.body, r.extra, r.link].map(q).join(', ')})`).join(',\n');
const hash = createHash('sha256').update(values).digest('hex').slice(0, 16);
const sql = `-- GENERATED by scripts/knowledge-seed.mts from Terms.tsx, Privacy.tsx and lib/guides.ts. Do not edit by hand.
-- Needs 0282. Paste whenever it changes; safe to paste again. ${rows.length} rows, texts ${hash}.
begin;
create temporary table _k (id text, source text, audience text, title text, body text, extra text, link text) on commit drop;
insert into _k values
${values};
delete from knowledge_chunks c where not exists (select 1 from _k where _k.id = c.id);
insert into knowledge_chunks (id, source, audience, title, body, extra, link)
select id, source, audience, title, body, extra, link from _k
on conflict (id) do update set source = excluded.source, audience = excluded.audience, title = excluded.title,
  body = excluded.body, extra = excluded.extra, link = excluded.link;
insert into knowledge_meta (id, texts_hash, updated_at) values (true, '${hash}', now())
on conflict (id) do update set texts_hash = excluded.texts_hash, updated_at = excluded.updated_at;
commit;
`;

const OUT = 'supabase/knowledge/texts.sql';
if (process.argv.includes('--check')) {
  let now = '';
  try { now = readFileSync(OUT, 'utf8').replace(/\r\n/g, '\n'); } catch { /* missing counts as stale */ }
  if (now !== sql) { console.error(`${OUT} is stale: run node --experimental-strip-types scripts/knowledge-seed.mts and paste it.`); process.exit(1); }
  console.log(`${OUT} is current (${rows.length} rows, texts ${hash}).`);
} else {
  mkdirSync('supabase/knowledge', { recursive: true });
  writeFileSync(OUT, sql);
  console.log(`written ${OUT}: ${rows.length} rows, texts ${hash}`);
}
